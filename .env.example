# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; never commit real keys.

# Modal (GPU inference endpoints) — https://modal.com/settings/tokens
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Baseten (Meta open-weight models, hackathon credits) — https://app.baseten.co/settings/api_keys
BASETEN_API_KEY=

# Hugging Face (download Meta open-weight models) — https://huggingface.co/settings/tokens
HF_TOKEN=

# Meta Model API (Muse models). Create at https://dev.meta.ai → API keys → Create API key.
# Name matches Meta's docs. Standard models only; see HACKATHON.md.
# Local development only: never embed this key in an app build.
MODEL_API_KEY=

# Göster bana iPhone app: the Mac's Tailscale MagicDNS name (for example my-mac.tail1234.ts.net).
# When set, the server also listens on that Tailscale address, for /api/guide/* only. Empty: loopback only.
NOVA_GUIDE_HOST=

# Göster bana for testers outside the tailnet: the public host name a tunnel (Cloudflare Tunnel) forwards to
# 127.0.0.1:NOVA_GUIDE_PUBLIC_PORT. Every request there needs an invite code: python3 web-prototype/guide.py invite NAME
# Empty: no internet listener.
NOVA_PUBLIC_HOST=
NOVA_GUIDE_PUBLIC_PORT=9015
# Where that listener binds; a reverse proxy in Docker needs the bridge address.
NOVA_GUIDE_PUBLIC_BIND=
