# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; never commit real keys.

# Modal (GPU inference endpoints) — https://modal.com/settings/tokens
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Hugging Face (download Meta open-weight models) — https://huggingface.co/settings/tokens
HF_TOKEN=

# Meta Model API (Muse models). Create at https://dev.meta.ai → API keys → Create API key.
# Name matches Meta's docs. Standard models only; see HACKATHON.md.
# Local development only: never embed this key in an app build.
MODEL_API_KEY=
