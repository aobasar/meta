      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal (1x)"
          }
        }
      }
    },
    "Not for gas, electrical panels, vehicles or medication.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaz, elektrik panosu, araç ve ilaç için kullanma."
          }
        }
      }
    },
    "Not sure.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emin değilim."
          }
        }
      }
    },
    "Not yet. Check the marker and try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz değil. İşarete bakıp yeniden deneyin."
          }
        }
      }
    },
    "Nova can't guide this safely.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova bu konuda güvenle yol gösteremez."
          }
        }
      }
    },
    "Nova couldn't find the controls for this.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova bunun için gereken düğmeleri bulamadı."
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamam"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı"
          }
        }
      }
    },
    "On": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık"
          }
        }
      }
    },
    "One step at a time, large and read aloud.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adım adım, büyük yazıyla ve sesli."
          }
        }
      }
    },
    "Planning the steps…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adımlar planlanıyor…"
          }
        }
      }
    },
    "Point the camera at the control, then check again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerayı düğmeye tutun, sonra yeniden kontrol edin."
          }
        }
      }
    },
    "Point the camera at the device in better light.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerayı daha aydınlık bir ortamda cihaza tutun."
          }
        }
      }
    },
    "Point the camera at what you need help with, then tap Pulse and say what you want to do.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerayı yardım istediğin şeye tut, sonra Pulse'a dokunup ne yapmak istediğini söyle."
          }
        }
      }
    },
    "Point the camera; the right control gets marked.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerayı tut, doğru yer işaretlenir."
          }
        }
      }
    },
