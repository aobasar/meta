      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone dili"
          }
        }
      }
    },
    "none yet": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "henüz yok"
          }
        }
      }
    },
    "pending": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bekliyor"
          }
        }
      }
    },
