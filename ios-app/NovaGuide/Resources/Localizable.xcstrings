{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ s": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sn"
          }
        }
      }
    },
    "AI-generated guidance. Check before you press.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zekâ yönlendirmesidir. Basmadan önce kontrol edin."
          }
        }
      }
    },
    "AI-generated guidance. Check before you press. It can be wrong; labels and manuals come first.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zekâ yönlendirmesidir; basmadan önce kontrol et. Hatalı olabilir; etiket ve kılavuz önce gelir."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakkında"
          }
        }
      }
    },
    "Allow Nova Guide to add to Photos in Settings, then try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'da Nova Guide'ın Fotoğraflar'a eklemesine izin ver, sonra tekrar dene."
          }
        }
      }
    },
    "Allow the microphone in Settings to talk to Nova.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova ile konuşmak için Ayarlar'dan mikrofona izin verin."
          }
        }
      }
    },
    "Answer": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cevap"
          }
        }
      }
    },
    "Ask": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soru sor"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik"
          }
        }
      }
    },
    "Automatic: speak Turkish or English and Nova answers in the same language. Words printed on the device are read in their own language.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik: Türkçe ya da İngilizce konuş, Nova aynı dilde cevap verir. Cihazın üstünde yazan kelimeler kendi dillerinde okunur."
          }
        }
      }
    },
    "Back to the question": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soruya dön"
          }
        }
      }
    },
    "Before you share, check that no faces or personal details are in the video.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşmadan önce videoda yüz ya da kişisel bilgi olmadığından emin ol."
          }
        }
      }
    },
    "Before you start": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamadan önce"
          }
        }
      }
    },
    "Built with Muse Spark Open": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Built with Muse Spark Open"
          }
        }
      }
    },
    "Camera": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera"
          }
        }
      }
    },
    "Camera tracking is not available.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera takibi kullanılamıyor."
          }
        }
      }
    },
    "Check": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol"
          }
        }
      }
    },
    "Check again": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden kontrol et"
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol ediliyor…"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapat"
          }
        }
      }
    },
    "Connected over the internet": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnternet üzerinden bağlı"
          }
        }
      }
    },
    "Connected to the Mac (Tailscale)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'e bağlı (Tailscale)"
          }
        }
      }
    },
