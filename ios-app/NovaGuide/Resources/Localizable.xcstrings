      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam"
          }
        }
      }
    },
    "Continue 5 s after a check": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulanınca 5 sn sonra devam et"
          }
