{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "AI-generated guidance. Check before you press.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zekâ yönlendirmesidir. Basmadan önce kontrol edin."
          }
        }
      }
    },
    "Allow the microphone in Settings to talk to Nova.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova ile konuşmak için Ayarlar'dan mikrofona izin verin."
          }
        }
      }
    },
    "Almost there…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neredeyse hazır…"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri"
          }
        }
      }
    },
    "Camera tracking is not available.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera takibi kullanılamıyor."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazgeç"
          }
        }
      }
    },
    "Check again": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden kontrol et"
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol ediliyor…"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapat"
          }
        }
      }
    },
    "Correct.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğru."
          }
        }
      }
    },
    "Depth sensor": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Derinlik sensörü"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaptım"
          }
        }
      }
    },
    "Finding the controls…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düğmeler bulunuyor…"
          }
        }
      }
    },
    "Finish": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitir"
          }
        }
      }
    },
    "Hold the phone steady for a moment.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu bir an sabit tutun."
          }
        }
      }
    },
    "Hold the phone steady, then check again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu sabit tutun, sonra yeniden kontrol edin."
          }
        }
      }
    },
    "How does this device work?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz nasıl çalışır?"
          }
        }
      }
    },
    "I can't see it clearly. Move closer and check again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Net göremiyorum. Yaklaşıp yeniden kontrol edin."
          }
        }
      }
    },
    "I didn't catch that. Please say it again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlayamadım. Lütfen tekrar söyleyin."
          }
        }
      }
    },
    "I didn't hear anything. Tap the microphone and speak.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şey duymadım. Mikrofona dokunup konuşun."
          }
        }
      }
    },
    "I speak": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuştuğum dil"
          }
        }
      }
    },
    "I want a normal wash": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal yıkama yapmak istiyorum"
          }
        }
      }
    },
    "Internet address": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnternet adresi"
          }
        }
      }
    },
    "Invite code": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet kodu"
          }
        }
      }
    },
    "Invite code not accepted": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet kodu kabul edilmedi"
          }
        }
      }
    },
    "LiDAR": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiDAR"
          }
        }
      }
    },
    "Listening…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinliyorum…"
          }
        }
      }
    },
    "Mac (Tailscale)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac (Tailscale)"
          }
        }
      }
    },
    "Mac address": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac adresi"
          }
        }
      }
    },
    "Mac not reachable": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'e ulaşılamıyor"
          }
        }
      }
    },
    "Mac over Tailscale": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale üzerinden Mac"
          }
        }
      }
    },
    "Move the phone closer to the control, then check again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu düğmeye yaklaştırın, sonra yeniden kontrol edin."
          }
        }
      }
    },
    "Move the phone more slowly.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu daha yavaş hareket ettirin."
          }
        }
      }
    },
    "New question": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni soru"
          }
        }
      }
    },
    "None (less precise)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yok (daha az hassas)"
          }
        }
      }
    },
    "Not yet. Check the marker and try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz değil. İşarete bakıp yeniden deneyin."
          }
        }
      }
    },
    "Nova (internet)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova (internet)"
          }
        }
      }
    },
    "Nova Guide shows where to touch; you do every step yourself. Its guidance is AI-generated and can be wrong.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova Guide nereye dokunacağınızı gösterir; her adımı siz yaparsınız. Yönlendirmeler yapay zekâ ile üretilir ve hatalı olabilir."
          }
        }
      }
    },
    "Nova can't guide this safely.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova bu konuda güvenle yol gösteremez."
          }
        }
      }
    },
    "Nova couldn't find the controls for this.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova bunun için gereken düğmeleri bulamadı."
          }
        }
      }
    },
    "Nova over the internet": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnternet üzerinden Nova"
          }
        }
      }
    },
    "Planning the steps…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adımlar planlanıyor…"
          }
        }
      }
    },
    "Point the camera at the control, then check again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerayı düğmeye tutun, sonra yeniden kontrol edin."
          }
        }
      }
    },
    "Point the camera at the device in better light.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerayı daha aydınlık bir ortamda cihaza tutun."
          }
        }
      }
    },
    "Ready.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır."
          }
        }
      }
    },
    "Recognizing the device…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz tanınıyor…"
          }
        }
      }
    },
    "Recording": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt"
          }
        }
      }
    },
    "Recording mode": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt modu"
          }
        }
      }
    },
    "Repeat": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrarla"
          }
        }
      }
    },
    "Set the Mac's address in Settings.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'dan Mac'in adresini girin."
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar"
          }
        }
      }
    },
    "Show me": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göster bana"
          }
        }
      }
    },
    "Skip, I did it": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geç, yaptım"
          }
        }
      }
    },
    "Step %lld / %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adım %1$lld / %2$lld"
          }
        }
      }
    },
    "Stop listening": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinlemeyi durdur"
          }
        }
      }
    },
    "Talk to Nova": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova ile konuş"
          }
        }
      }
    },
    "The Mac answered with HTTP %lld.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac HTTP %lld ile yanıt verdi."
          }
        }
      }
    },
    "The Mac has no API key": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'te API anahtarı yok"
          }
        }
      }
    },
    "The Mac sent an answer the app couldn't read.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'in gönderdiği yanıt okunamadı."
          }
        }
      }
    },
    "The camera isn't ready yet. Point it at the device and try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera henüz hazır değil. Cihaza tutup yeniden deneyin."
          }
        }
      }
    },
    "The microphone couldn't start.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon başlatılamadı."
          }
        }
      }
    },
    "Thinking…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşünüyorum…"
          }
        }
      }
    },
    "Tilt the phone down": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu aşağı eğin"
          }
        }
      }
    },
    "Tilt the phone up": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu yukarı eğin"
          }
        }
      }
    },
    "Tried first. Needs the invite code you were given; it is kept in this iPhone's Keychain.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bu denenir. Size verilen davet kodu gerekir; kod bu iPhone'un Keychain'inde saklanır."
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden dene"
          }
        }
      }
    },
    "Turn the phone left": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu sola çevirin"
          }
        }
      }
    },
    "Turn the phone right": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu sağa çevirin"
          }
        }
      }
    },
    "Understanding…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlıyorum…"
          }
        }
      }
    },
    "Used when the internet address doesn't answer. The phone never holds the API key; the Mac does.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnternet adresi yanıt vermezse kullanılır. API anahtarı telefonda değil, Mac'te durur."
          }
        }
      }
    },
    "What do you want to do?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne yapmak istiyorsunuz?"
          }
        }
      }
    },
    "When on, your Mac saves each camera frame and answer for testing. Nothing is saved on the phone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıkken Mac'iniz test için her kamera karesini ve yanıtı kaydeder. Telefona hiçbir şey kaydedilmez."
          }
        }
      }
    }
  }
}
